      },
      "body": "County Council Special Meeting"
    },
    {
      "dateISO": "2026-09-30",
      "text": "The chair said a resolution adopted on February 11, 2008, made Fukuyama City a sister city of Maui County.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "oZNc2fyyOPE",
