        "retrievedISO": "2026-10-16T03:41:33.571Z",
        "endTs": "0:02:42"
      },
      "body": "County Council Special Meeting"
    },
    {
      "dateISO": "2026-09-30",
      "text": "The Maui County Council held a special meeting to welcome members of the Fukuyama City Assembly.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "oZNc2fyyOPE",
