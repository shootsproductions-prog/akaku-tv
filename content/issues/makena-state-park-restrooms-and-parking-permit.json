  "timeline": [
    {
      "dateISO": "2026-07-14",
      "text": "The commission approved the permit, six to one.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "Ail920zTE4c",
        "ts": "2:21:29",
        "retrievedISO": "2026-10-13T06:35:14.575Z",
        "endTs": "2:22:02"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2026-07-14",
      "text": "A State Parks lawyer said resident-only parking would likely be found unconstitutional.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "Ail920zTE4c",
        "ts": "2:04:23",
        "retrievedISO": "2026-10-13T06:35:14.575Z",
        "endTs": "2:05:03"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2026-07-14",
      "text": "Commissioners added a condition that the study report is due by July 31, 2029.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "Ail920zTE4c",
        "ts": "1:59:52",
        "retrievedISO": "2026-10-13T06:35:14.575Z",
        "endTs": "2:01:36"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2026-07-14",
      "text": "Planning staff said they will revise condition 3 to reference the State's July 2 letter.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "Ail920zTE4c",
        "ts": "1:28:40",
        "retrievedISO": "2026-10-13T06:35:14.575Z",
        "endTs": "1:29:26"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2026-07-14",
      "text": "State Parks will keep working with the fire department to fix tight spots in the parking lot.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "Ail920zTE4c",
        "ts": "0:27:38",
        "retrievedISO": "2026-10-13T06:35:14.575Z",
        "endTs": "0:28:12"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2026-07-14",
      "text": "Public testimony closed at the June 23 meeting.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "Ail920zTE4c",
        "ts": "0:02:06",
        "retrievedISO": "2026-10-13T06:35:14.575Z",
        "endTs": "0:02:36"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2026-07-14",
      "text": "The commission returned to a State Parks request for restrooms, showers, and parking upgrades at Mākena State Park.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "Ail920zTE4c",
        "ts": "0:01:36",
        "retrievedISO": "2026-10-13T06:35:14.575Z",
        "endTs": "0:02:16"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2026-06-23",
      "text": "The July 14 agenda includes Mākena State Park, an appeal, a decision for a solar project, and an introduction to rewriting the zoning code.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "FfcosWuFLCA",
        "ts": "7:24:38",
        "retrievedISO": "2026-10-14T06:40:06.726Z",
        "endTs": "7:25:38"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2026-06-23",
      "text": "The commission voted six in favor to defer the permit to July 14 so the state can answer its questions.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "FfcosWuFLCA",
        "ts": "7:19:44",
        "retrievedISO": "2026-10-14T06:40:06.726Z",
        "endTs": "7:20:51"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2026-06-23",
      "text": "The state is to say whether it has an agreement to connect to a nearby resort's wastewater treatment plant.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "FfcosWuFLCA",
        "ts": "7:17:08",
        "retrievedISO": "2026-10-14T06:40:06.726Z",
        "endTs": "7:17:38"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2026-06-23",
      "text": "The state is to answer in writing on a bike path, resident parking, court status, sewer connection, a carrying capacity study, pervious paving, lighting and fire truck access.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "FfcosWuFLCA",
        "ts": "7:16:48",
        "retrievedISO": "2026-10-14T06:40:06.726Z",
        "endTs": "7:18:04"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2026-06-23",
      "text": "The state apologized for installing two booths and three pay stations without Special Management Area (SMA) approval.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "FfcosWuFLCA",
        "ts": "5:45:54",
        "retrievedISO": "2026-10-14T06:40:06.726Z",
        "endTs": "5:46:36"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2026-06-23",
      "text": "The state said parking would grow from 238 to 276 spaces, about 13 percent.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "FfcosWuFLCA",
        "ts": "5:29:16",
        "retrievedISO": "2026-10-14T06:40:06.726Z",
        "endTs": "5:30:30"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2026-06-23",
      "text": "With eight votes, the commission denied a late-filed petition to intervene (a request to join the case as a formal party).",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "FfcosWuFLCA",
        "ts": "5:25:27",
        "retrievedISO": "2026-10-14T06:40:06.726Z",
        "endTs": "5:26:21"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2026-06-23",
      "text": "A former lifeguard lieutenant said the beach leads the state in spinal injuries.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "FfcosWuFLCA",
        "ts": "4:11:00",
        "retrievedISO": "2026-10-14T06:40:06.726Z",
        "endTs": "4:12:22"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2026-06-23",
      "text": "A wildlife group leader said it is the most successful turtle nesting beach they monitor on Maui.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "FfcosWuFLCA",
        "ts": "3:18:33",
        "retrievedISO": "2026-10-14T06:40:06.726Z",
        "endTs": "3:19:03"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2026-06-23",
      "text": "One testifier supported permanent restrooms, saying people now leave toilet paper in the bushes.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "FfcosWuFLCA",
        "ts": "2:31:05",
        "retrievedISO": "2026-10-14T06:40:06.726Z",
        "endTs": "2:31:35"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2026-06-23",
      "text": "A testifier said new showers and bathrooms raise water-use concerns while the island is under drought.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "FfcosWuFLCA",
        "ts": "1:53:07",
        "retrievedISO": "2026-10-14T06:40:06.726Z",
        "endTs": "1:53:45"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2026-06-23",
      "text": "The restroom wastewater tanks would hold 13,000 gallons at the north site and 7,000 gallons at the south site.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "FfcosWuFLCA",
        "ts": "1:11:28",
        "retrievedISO": "2026-10-14T06:40:06.726Z",
        "endTs": "1:11:58"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2026-06-23",
      "text": "Leach outdoor shower would drain through a swale to a grass drainage basin.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "FfcosWuFLCA",
        "ts": "1:05:59",
        "retrievedISO": "2026-10-14T06:40:06.726Z",
        "endTs": "1:06:29"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2026-06-23",
      "text": "The state said the plan includes no fencing, reservation system or shuttle-only access.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "FfcosWuFLCA",
        "ts": "1:03:57",
        "retrievedISO": "2026-10-14T06:40:06.726Z",
        "endTs": "1:04:46"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2026-06-23",
      "text": "Restroom wastewater would be held in underground tanks and trucked away for treatment.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "FfcosWuFLCA",
        "ts": "1:02:39",
        "retrievedISO": "2026-10-14T06:40:06.726Z",
        "endTs": "1:03:09"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2026-06-23",
      "text": "Two new water service lines would connect to the existing 12-inch water line on the road.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "FfcosWuFLCA",
        "ts": "1:02:28",
        "retrievedISO": "2026-10-14T06:40:06.726Z",
        "endTs": "1:02:58"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2026-06-23",
      "text": "The Mākena State Park plan would bring water service to the park for toilets, sinks, showers and a bottle-filling station.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "FfcosWuFLCA",
        "ts": "0:52:03",
        "retrievedISO": "2026-10-14T06:40:06.726Z",
        "endTs": "0:52:35"
      },
      "body": "Maui Planning Commission"
    }
  ],
