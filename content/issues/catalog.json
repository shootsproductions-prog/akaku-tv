      "signals": {
        "meetingsLast30d": 0,
        "meetingsLast90d": 2,
        "mentionsLast30d": 0,
        "upcomingEvent": null
      },
      "asOfISO": "2026-10-23",
      "timeline": [
        {
          "dateISO": "2026-09-17",
          "text": "Project updates will be posted on the county website landing page.",
          "basis": "said-at-meeting",
          "source": {
            "type": "meeting",
            "videoId": "pNKa-YoxirU",
            "ts": "1:10:06",
            "retrievedISO": "2026-10-07T23:03:47.562Z"
          },
          "body": "Maui County Department of Transportation"
        },
        {
          "dateISO": "2026-09-17",
          "text": "Residents were asked to fill out a questionnaire through a QR code in the brochure.",
          "basis": "said-at-meeting",
          "source": {
            "type": "meeting",
            "videoId": "pNKa-YoxirU",
