            "videoId": "3Jc9Mp68Wcs",
            "ts": "0:09:38",
            "retrievedISO": "2026-10-07T23:03:48.406Z"
          }
        },
        {
          "dateISO": "2026-09-23",
          "text": "Board members will work recruiting shifts at the county fair.",
          "basis": "said-at-meeting",
          "source": {
            "type": "meeting",
            "videoId": "3Jc9Mp68Wcs",
            "ts": "0:08:14",
            "retrievedISO": "2026-10-07T23:03:48.406Z"
          }
        },
        {
          "dateISO": "2026-09-09",
          "text": "Staff agreed to bring a plan and timeline for the Temporary Investigative Group (TIG) to the next meeting.",
