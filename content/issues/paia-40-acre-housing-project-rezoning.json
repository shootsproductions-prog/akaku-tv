      "source": {
        "type": "meeting",
        "videoId": "tcJLaiUZhjo",
        "ts": "0:55:21",
        "retrievedISO": "2026-10-07T23:03:57.780Z",
        "endTs": "0:55:53"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2026-09-08",
      "text": "The projected drinking water demand is 75,738 gallons per day.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "tcJLaiUZhjo",
        "ts": "0:53:53",
        "retrievedISO": "2026-10-07T23:03:57.780Z",
        "endTs": "0:54:23"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2026-09-08",
      "text": "At least 34 workforce rentals would stay affordable forever for households earning up to 120% of the area median income.",
