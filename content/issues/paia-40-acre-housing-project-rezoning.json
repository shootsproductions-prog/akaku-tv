      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2026-09-08",
      "text": "The commission's attorney advised the council to hold the zoning until the state Land Use Commission approves a change from agriculture to urban.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "tcJLaiUZhjo",
        "ts": "3:29:07",
        "retrievedISO": "2026-10-07T23:03:57.780Z",
        "endTs": "3:29:39"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2026-09-08",
      "text": "The County Council will review the commission's recommendations.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "tcJLaiUZhjo",
        "ts": "3:26:11",
        "retrievedISO": "2026-10-07T23:03:57.780Z",
        "endTs": "3:26:41"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2026-09-08",
      "text": "A Pahia homeowner of 25 years testified in opposition.",
