      "source": {
        "type": "meeting",
        "videoId": "sf2Uy63wJNE",
        "ts": "1:42:56",
        "retrievedISO": "2026-10-07T20:19:47.406Z"
      },
      "body": "Civil Service Commission"
    },
    {
      "dateISO": "2026-09-30",
      "text": "The second candidate said he is a public works deputy director with 11 years at the county.",
