        "type": "meeting",
        "videoId": "sf2Uy63wJNE",
        "ts": "3:22:07",
        "retrievedISO": "2026-10-07T20:19:47.406Z"
      },
      "body": "Civil Service Commission"
    },
    {
      "dateISO": "2026-09-30",
      "text": "Public testimony will be accepted up to the day of the meeting, but earlier written testimony gives commissioners more time to review it.",
