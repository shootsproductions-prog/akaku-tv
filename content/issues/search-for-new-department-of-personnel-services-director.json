      "source": {
        "type": "meeting",
        "videoId": "H9lx2zorcDM",
        "ts": "0:17:26",
        "retrievedISO": "2026-10-06T04:46:18.801Z"
      },
      "body": "Civil Service Commission"
    },
    {
      "dateISO": "2026-09-28",
      "text": "Employees are invited to watch the interviews live and send anonymous comments afterward.",
