        "type": "meeting",
        "videoId": "H9lx2zorcDM",
        "ts": "0:24:24",
        "retrievedISO": "2026-10-06T04:46:18.801Z"
      },
      "body": "Civil Service Commission"
    },
    {
      "dateISO": "2026-09-28",
      "text": "Final choices on who asks which question must be made after the meeting starts at 9:00.",
