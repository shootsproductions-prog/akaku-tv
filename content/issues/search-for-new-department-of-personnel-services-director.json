        "retrievedISO": "2026-10-07T20:19:47.406Z"
      },
      "body": "Civil Service Commission"
    },
    {
      "dateISO": "2026-09-30",
      "text": "The Civil Service Commission of the County of Maui met September 30, 2026, at about 9:02 a.m.",
