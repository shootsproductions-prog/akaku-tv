      "source": {
        "type": "meeting",
        "videoId": "sf2Uy63wJNE",
        "ts": "1:01:11",
        "retrievedISO": "2026-10-07T20:19:47.406Z"
      },
      "body": "Civil Service Commission"
    },
    {
      "dateISO": "2026-09-30",
      "text": "The first candidate said his approach would have a strong labor focus built on trust.",
