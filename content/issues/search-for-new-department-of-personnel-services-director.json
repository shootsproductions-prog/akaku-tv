      "source": {
        "type": "meeting",
        "videoId": "sf2Uy63wJNE",
        "ts": "3:01:16",
        "retrievedISO": "2026-10-07T20:19:47.406Z"
      },
      "body": "Civil Service Commission"
    },
    {
      "dateISO": "2026-09-30",
      "text": "Commissioners may ask the candidates follow-up questions by phone and bring the answers back to the whole commission.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "sf2Uy63wJNE",
        "ts": "2:49:04",
        "retrievedISO": "2026-10-07T20:19:47.406Z"
      },
      "body": "Civil Service Commission"
    },
    {
      "dateISO": "2026-09-30",
      "text": "Commissioners plan to meet October 7 to review the candidates and hopefully decide.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "sf2Uy63wJNE",
        "ts": "2:48:53",
        "retrievedISO": "2026-10-07T20:19:47.406Z"
      },
      "body": "Civil Service Commission"
    },
    {
      "dateISO": "2026-09-30",
      "text": "Candidates will be told the commission's decision.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "sf2Uy63wJNE",
        "ts": "2:47:25",
        "retrievedISO": "2026-10-07T20:19:47.406Z"
      },
      "body": "Civil Service Commission"
    },
    {
      "dateISO": "2026-09-30",
      "text": "She said she is applying because she worries the county's HR project could fall flat.",
