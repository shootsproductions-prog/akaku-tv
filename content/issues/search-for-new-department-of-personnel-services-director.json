      "source": {
        "type": "meeting",
        "videoId": "sf2Uy63wJNE",
        "ts": "0:05:13",
        "retrievedISO": "2026-10-07T20:19:47.406Z"
      },
      "body": "Civil Service Commission"
    },
    {
      "dateISO": "2026-09-30",
      "text": "The meeting was for interviews of candidates for Department of Personnel Services (DPS) director.",
