  "timeline": [
    {
      "dateISO": "2024-11-25",
      "text": "Executive director's proposed changes to the long-range transportation plan action plan: The board approved the executive director's proposed changes to the long-range transportation plan action plan.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "Waw25HcUMYM",
        "ts": "0:35:14",
        "retrievedISO": "2026-10-15T06:35:15.349Z"
      },
      "body": "MPO Policy Board"
    },
    {
      "dateISO": "2024-11-25",
      "text": "The executive director said the plan will adopt all of the transportation projects in the recovery plan.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "Waw25HcUMYM",
        "ts": "0:33:15",
        "retrievedISO": "2026-10-15T06:35:15.349Z"
      },
      "body": "MPO Policy Board"
    },
    {
      "dateISO": "2024-11-25",
      "text": "The final plan is meant to be adopted before April 15.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "Waw25HcUMYM",
        "ts": "0:27:33",
        "retrievedISO": "2026-10-15T06:35:15.349Z"
      },
      "body": "MPO Policy Board"
    },
    {
      "dateISO": "2024-11-25",
      "text": "A draft plan is set to come to the board in February.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "Waw25HcUMYM",
        "ts": "0:27:01",
        "retrievedISO": "2026-10-15T06:35:15.349Z"
      },
      "body": "MPO Policy Board"
    },
    {
      "dateISO": "2024-11-25",
      "text": "The new long-range transportation plan will reflect the long-term recovery plan for West Maui.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "Waw25HcUMYM",
        "ts": "0:23:29",
        "retrievedISO": "2026-10-15T06:35:15.349Z"
      },
      "body": "MPO Policy Board"
    },
    {
      "dateISO": "2024-11-25",
      "text": "The executive director proposed a full 2045 plan update instead of reaffirming the 2040 plan, with work extended to mid-April.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "Waw25HcUMYM",
        "ts": "0:20:12",
        "retrievedISO": "2026-10-15T06:35:15.349Z"
      },
      "body": "MPO Policy Board"
    },
    {
      "dateISO": "2024-11-25",
      "text": "Contract money went to the TIP update, so too little is left for all the planned work.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "Waw25HcUMYM",
        "ts": "0:18:03",
        "retrievedISO": "2026-10-15T06:35:15.349Z"
      },
      "body": "MPO Policy Board"
    },
    {
      "dateISO": "2024-11-25",
      "text": "Without a valid plan, the board cannot amend its transportation improvement program, or TIP.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "Waw25HcUMYM",
        "ts": "0:16:18",
        "retrievedISO": "2026-10-15T06:35:15.349Z"
      },
      "body": "MPO Policy Board"
    },
    {
      "dateISO": "2024-11-25",
      "text": "The prior director did not want a plan update that left out West Maui while no long-term recovery plan existed.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "Waw25HcUMYM",
        "ts": "0:15:07",
        "retrievedISO": "2026-10-15T06:35:15.349Z"
      },
      "body": "MPO Policy Board"
    },
    {
      "dateISO": "2024-11-25",
      "text": "Staff said work on the new plan was complicated by the August wildfires last year.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "Waw25HcUMYM",
        "ts": "0:14:21",
        "retrievedISO": "2026-10-15T06:35:15.349Z"
      },
      "body": "MPO Policy Board"
    },
    {
      "dateISO": "2024-11-25",
      "text": "The executive director said the current long-range transportation plan expires at the end of this year.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "Waw25HcUMYM",
        "ts": "0:14:07",
        "retrievedISO": "2026-10-15T06:35:15.349Z"
      },
      "body": "MPO Policy Board"
    },
    {
      "dateISO": "2024-11-12",
      "text": "The director's proposed changes to the plan update go to the policy board this month.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "0Y9Q-olLylQ",
        "ts": "1:17:34",
        "retrievedISO": "2026-10-15T06:35:26.512Z"
      },
      "body": "Maui MPO Technical Advisory Committee"
    },
    {
      "dateISO": "2024-11-12",
      "text": "The director said the only projects expected to need adding to the project list are from the West Maui rebuild.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "0Y9Q-olLylQ",
        "ts": "1:15:13",
        "retrievedISO": "2026-10-15T06:35:26.512Z"
      },
      "body": "Maui MPO Technical Advisory Committee"
    },
    {
      "dateISO": "2024-11-12",
      "text": "Until a new plan is adopted, the list of funded projects (the TIP) cannot be changed.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "0Y9Q-olLylQ",
        "ts": "1:14:37",
        "retrievedISO": "2026-10-15T06:35:26.512Z"
      },
      "body": "Maui MPO Technical Advisory Committee"
    },
    {
      "dateISO": "2024-11-12",
      "text": "The director asked to give the consultants until the end of March, instead of February, to finish the plan update.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "0Y9Q-olLylQ",
        "ts": "1:04:36",
        "retrievedISO": "2026-10-15T06:35:26.512Z"
      },
      "body": "Maui MPO Technical Advisory Committee"
    },
    {
      "dateISO": "2024-11-12",
      "text": "The director said the earlier plan was made before any community engagement on rebuilding West Maui.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "0Y9Q-olLylQ",
        "ts": "1:02:11",
        "retrievedISO": "2026-10-15T06:35:26.512Z"
      },
      "body": "Maui MPO Technical Advisory Committee"
    },
    {
      "dateISO": "2024-11-12",
      "text": "The executive director said the current long range transportation plan expires at the end of the year.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "0Y9Q-olLylQ",
        "ts": "0:59:50",
        "retrievedISO": "2026-10-15T06:35:26.512Z"
      },
      "body": "Maui MPO Technical Advisory Committee"
    },
    {
      "dateISO": "2024-11-12",
      "text": "A consultant said the plan will be finalized by the end of December.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "0Y9Q-olLylQ",
        "ts": "0:23:09",
        "retrievedISO": "2026-10-15T06:35:26.512Z"
      },
      "body": "Maui MPO Technical Advisory Committee"
    }
  ],
