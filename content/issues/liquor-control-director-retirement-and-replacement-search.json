      "dateISO": "2026-11-12",
      "text": "The department will send the proposal scores to finance to finish the selection process.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "-_32YWWsXRA",
        "ts": "3:02:55",
