  "timeline": [
    {
      "dateISO": "2026-10-09",
      "text": "The Maui County Council's ADEPT Committee listed the Maui County Ferry Feasibility Study on its master agenda.",
      "basis": "reported",
      "source": {
        "type": "county-page",
        "url": "https://mauicounty.us/wp-content/uploads/2026/10/adeptitems.pdf",
        "publisher": "Maui County Council",
        "quote": "Sub-item (1) MAUI COUNTY FERRY FEASIBILITY STUDY.",
        "retrievedISO": "2026-10-26T07:58:40.763Z"
      }
    },
    {
      "dateISO": "2026-09-22",
      "text": "The County announced special ferry and shuttle options for Lānaʻi and Molokaʻi residents to attend the 99th Maui County Fair, including a $25 boat and bus package from Molokaʻi.",
      "basis": "reported",
      "source": {
        "type": "county-release",
        "url": "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQFmL5VJea78P9J8zZEIe1BSRxGs9uiWaBbxaszLk1jg8sGnbbFRabfKUK8YpvNnYWp25_Vxpv17Ka8IYmFPNEKU0kuzHqDJyXWnkUt-mshsuw3C3hYaJ9Rbto5gvWZiibmGRVzFp_NvCW9Zu-AK",
        "publisher": "County of Maui Department of Transportation",
        "quote": "Molokaʻi residents are also invited to make the trip to the Maui County Fair with a special $25 boat and bus shuttle package.",
        "retrievedISO": "2026-10-26T07:58:47.255Z"
      }
    },
    {
      "dateISO": "2026-09-20",
      "text": "Maui Now reported the county's procurement target: a request for proposals in January 2027 and a Lānaʻi launch in mid-2027. The page does not mention these dates.",
      "basis": "reported",
      "source": {
        "type": "other",
        "url": "https://mauinow.com/2026/09/20/maui-county-run-ferry-service-aims-to-launch-for-lanai-next-year-molokai-in-2029/",
        "publisher": "Maui Now",
        "quote": "The goal is to put out a request for proposals in January 2027 and launch Lāna'i service in mid-2027.",
        "retrievedISO": "2026-10-26T07:58:53.636Z"
      }
    },
    {
      "dateISO": "2026-09-19",
      "text": "The County held the last of its four community ferry meetings on Lānaʻi, outlining procurement and service launch targets, including mid-2027 for Lānaʻi service.",
      "basis": "reported",
      "source": {
        "type": "other",
        "url": "https://www.lanaitoday.com/news/lnai-ferry-meeting-what-residents-raised-and-what-comes-next",
        "publisher": "Lanai Today",
        "quote": "The County is targeting mid-2027 for Lānaʻi ferry service to begin under a County-supported system.",
        "retrievedISO": "2026-10-26T07:58:59.973Z"
      }
    },
    {
      "dateISO": "2026-09-17",
      "text": "Project updates will be posted on the county website landing page.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "pNKa-YoxirU",
        "ts": "1:10:06",
        "retrievedISO": "2026-10-07T23:03:47.562Z",
        "endTs": "1:10:36"
      },
      "body": "Maui County Department of Transportation"
    },
    {
      "dateISO": "2026-09-17",
      "text": "Residents were asked to fill out a questionnaire through a QR code in the brochure.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "pNKa-YoxirU",
        "ts": "1:09:35",
        "retrievedISO": "2026-10-07T23:03:47.562Z",
        "endTs": "1:10:05"
      },
      "body": "Maui County Department of Transportation"
    },
    {
      "dateISO": "2026-09-17",
      "text": "Staff said a transportation study of harbor connections will start next month.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "pNKa-YoxirU",
        "ts": "1:02:53",
        "retrievedISO": "2026-10-07T23:03:47.562Z",
        "endTs": "1:03:23"
      },
      "body": "Maui County Department of Transportation"
    },
    {
      "dateISO": "2026-09-17",
      "text": "Staff said Molokaʻi fares would likely match Lānaʻi fares.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "pNKa-YoxirU",
        "ts": "0:55:13",
        "retrievedISO": "2026-10-07T23:03:47.562Z",
        "endTs": "0:55:43"
      },
      "body": "Maui County Department of Transportation"
    },
    {
      "dateISO": "2026-09-17",
      "text": "A resident said supplies, including food, ran short on Molokaʻi after a winter storm.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "pNKa-YoxirU",
        "ts": "0:27:36",
        "retrievedISO": "2026-10-07T23:03:47.562Z",
        "endTs": "0:28:20"
      },
      "body": "Maui County Department of Transportation"
    },
    {
      "dateISO": "2026-09-17",
      "text": "A draft environmental assessment will be released, and public comments will be added before it is finished.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "pNKa-YoxirU",
        "ts": "0:24:00",
        "retrievedISO": "2026-10-07T23:03:47.562Z",
        "endTs": "0:24:30"
      },
      "body": "Maui County Department of Transportation"
    },
    {
      "dateISO": "2026-09-17",
      "text": "The County Council, not the department, will set fares through the budget process.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "pNKa-YoxirU",
        "ts": "0:23:06",
        "retrievedISO": "2026-10-07T23:03:47.562Z",
        "endTs": "0:23:36"
      },
      "body": "Maui County Department of Transportation"
    },
    {
      "dateISO": "2026-09-17",
      "text": "The department will pass residents' fare suggestions to the County Council.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "pNKa-YoxirU",
        "ts": "0:23:02",
        "retrievedISO": "2026-10-07T23:03:47.562Z",
        "endTs": "0:23:37"
      },
      "body": "Maui County Department of Transportation"
    },
    {
      "dateISO": "2026-09-17",
      "text": "The current adult fare to Lānaʻi is $40 one way.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "pNKa-YoxirU",
        "ts": "0:22:37",
        "retrievedISO": "2026-10-07T23:03:47.562Z",
        "endTs": "0:23:07"
      },
      "body": "Maui County Department of Transportation"
    },
    {
      "dateISO": "2026-09-17",
      "text": "Ticket sales would cover about 60 percent of that, or about $3 million.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "pNKa-YoxirU",
        "ts": "0:21:26",
        "retrievedISO": "2026-10-07T23:03:47.562Z",
        "endTs": "0:21:56"
      },
      "body": "Maui County Department of Transportation"
    },
    {
      "dateISO": "2026-09-17",
      "text": "The yearly operating cost for Lānaʻi service is estimated at about $5 million, not counting new boats.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "pNKa-YoxirU",
        "ts": "0:20:50",
        "retrievedISO": "2026-10-07T23:03:47.562Z",
        "endTs": "0:21:29"
      },
      "body": "Maui County Department of Transportation"
    },
    {
      "dateISO": "2026-09-17",
      "text": "The Maui harbor has not been chosen; the county is waiting to see how the rebuild after the fires goes.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "pNKa-YoxirU",
        "ts": "0:16:46",
        "retrievedISO": "2026-10-07T23:03:47.562Z",
        "endTs": "0:17:16"
      },
      "body": "Maui County Department of Transportation"
    },
    {
      "dateISO": "2026-09-17",
      "text": "Molokaʻi service is hoped for by early 2029.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "pNKa-YoxirU",
        "ts": "0:15:21",
        "retrievedISO": "2026-10-07T23:03:47.562Z",
        "endTs": "0:15:51"
      },
      "body": "Maui County Department of Transportation"
    },
    {
      "dateISO": "2026-09-17",
      "text": "A private company would run it under a county contract chosen through a call for bids.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "pNKa-YoxirU",
        "ts": "0:14:51",
        "retrievedISO": "2026-10-07T23:03:47.562Z",
        "endTs": "0:15:36"
      },
      "body": "Maui County Department of Transportation"
    },
    {
      "dateISO": "2026-09-17",
      "text": "The ferry would carry passengers only, on vessels holding 149 people.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "pNKa-YoxirU",
        "ts": "0:14:34",
        "retrievedISO": "2026-10-07T23:03:47.562Z",
        "endTs": "0:15:04"
      },
      "body": "Maui County Department of Transportation"
    },
    {
      "dateISO": "2026-09-17",
      "text": "Residents said they want an affordable ferry to visit family and reach medical care on Maui.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "pNKa-YoxirU",
        "ts": "0:03:30",
        "retrievedISO": "2026-10-07T23:03:47.562Z",
        "endTs": "0:05:06"
      },
      "body": "Maui County Department of Transportation"
    },
    {
      "dateISO": "2026-09-17",
      "text": "A Maui County Department of Transportation staff member opened a community meeting on the proposed Maui Ferry project.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "pNKa-YoxirU",
        "ts": "0:00:03",
        "retrievedISO": "2026-10-07T23:03:47.562Z",
        "endTs": "0:00:33"
      },
      "body": "Maui County Department of Transportation"
    },
    {
      "dateISO": "2026-09-03",
      "text": "Recommendations to the Department of Transportation on the Maui County ferry environmental study: The commission voted to send its recommendations on the ferry study to the Department of Transportation, with no opposition heard.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "vhZUiN4y4Zw",
        "ts": "1:12:40",
        "retrievedISO": "2026-10-07T23:04:02.794Z",
        "endTs": "1:13:21"
      },
      "body": "Cultural Resources Commission"
    },
    {
      "dateISO": "2026-09-03",
      "text": "Planning staff said the commission's ferry comments would probably be sent sometime next week.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "vhZUiN4y4Zw",
