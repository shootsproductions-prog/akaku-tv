      "source": {
        "type": "meeting",
        "videoId": "Waw25HcUMYM",
        "ts": "0:48:31",
        "retrievedISO": "2026-10-15T06:35:15.349Z",
        "endTs": "0:49:01"
      },
      "body": "MPO Policy Board"
    },
    {
