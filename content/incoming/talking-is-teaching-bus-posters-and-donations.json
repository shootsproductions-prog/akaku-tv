    {
      "dateISO": "2024-12-16",
      "text": "A commissioner said Maui Family Support Services can take in donations set aside for printing the posters.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "eP7TRDIaloc",
        "ts": "0:30:21",
        "endTs": "0:31:12",
