      },
      "body": "Commission on Children & Youth"
    },
    {
      "dateISO": "2024-12-16",
      "text": "A deputy director said the commission has no budget of its own this fiscal year.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "eP7TRDIaloc",
        "ts": "0:11:50",
        "endTs": "0:12:20",
        "retrievedISO": "2026-10-15T06:35:06.512Z"
      },
      "body": "Commission on Children & Youth"
    },
    {
      "dateISO": "2024-11-18",
      "text": "The lawyer recommended the department send a request for legal services on whether the commission may ask for donations.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "ylzQrfRgg-g",
        "ts": "0:28:04",
        "endTs": "0:28:35",
        "retrievedISO": "2026-10-15T06:35:21.777Z"
      },
      "body": "Commission on Children and Youth"
    },
    {
      "dateISO": "2024-11-18",
      "text": "Whether the commission may ask for donations is still being researched.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "ylzQrfRgg-g",
        "ts": "0:28:02",
        "endTs": "0:29:01",
        "retrievedISO": "2026-10-15T06:35:21.777Z"
      },
      "body": "Commission on Children and Youth"
    },
    {
      "dateISO": "2024-11-18",
      "text": "The lawyer confirmed the poster printing is exempt from the procurement code (purchasing rules).",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "ylzQrfRgg-g",
        "ts": "0:27:03",
        "endTs": "0:27:33",
        "retrievedISO": "2026-10-15T06:35:21.777Z"
      },
      "body": "Commission on Children and Youth"
    },
    {
      "dateISO": "2024-11-18",
      "text": "One speaker said the commission's budget could not cover even the printing.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "ylzQrfRgg-g",
        "ts": "0:17:31",
        "endTs": "0:18:01",
        "retrievedISO": "2026-10-15T06:35:21.777Z"
      },
      "body": "Commission on Children and Youth"
    },
    {
      "dateISO": "2024-11-18",
      "text": "The chair said $20 per poster was only a guess.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "ylzQrfRgg-g",
        "ts": "0:13:37",
        "endTs": "0:14:07",
        "retrievedISO": "2026-10-15T06:35:21.777Z"
      },
      "body": "Commission on Children and Youth"
    },
    {
      "dateISO": "2024-11-18",
      "text": "The chair said about 70 posters would be needed.",
      "basis": "said-at-meeting",
      "source": {
