      },
      "body": "County Council Meeting"
    },
    {
      "dateISO": "2026-06-19",
      "text": "The chair asked the representative to come back when the item comes up.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "N5Uix8ba9zI",
        "ts": "1:57:46",
