      },
      "body": "County Council Meeting"
    },
    {
      "dateISO": "2024-10-25",
      "text": "The County's attorney said answers on how the change fits the water code would come by the Wednesday meeting.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "PanLlKqrVO8",
        "ts": "2:46:51",
        "endTs": "2:47:27",
        "retrievedISO": "2026-10-21T21:48:16.506Z"
      },
      "body": "County Council Meeting"
    },
    {
      "dateISO": "2024-10-25",
      "text": "The change would remove a water condition from the project's 2011 approval.",
      "basis": "said-at-meeting",
      "source": {
