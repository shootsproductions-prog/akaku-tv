        "videoId": "PanLlKqrVO8",
        "ts": "2:44:11",
        "endTs": "2:44:41",
        "retrievedISO": "2026-10-21T21:48:16.506Z"
      },
      "body": "County Council Meeting"
    },
    {
      "dateISO": "2024-10-25",
      "text": "A council member asked to move a West Maui housing project change forward to the Planning Commission.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "PanLlKqrVO8",
        "ts": "2:42:05",
        "endTs": "2:42:45",
