      "source": {
        "type": "meeting",
        "videoId": "usMfKSJ6LlI",
        "ts": "0:08:30",
        "endTs": "0:09:06",
        "retrievedISO": "2026-10-15T06:35:12.934Z"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2024-12-10",
      "text": "The main item was a Council resolution to change conditions on a West Maui housing project.",
