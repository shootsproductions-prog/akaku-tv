    {
      "dateISO": "2024-11-21",
      "text": "Draft letter of support to the state water commission about water for temporary housing: The chair deferred the draft letter, with changes, to the next meeting without a vote.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "XD60_Qatcxw",
        "ts": "0:53:46",
