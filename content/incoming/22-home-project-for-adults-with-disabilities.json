    {
      "dateISO": "2026-08-13",
      "text": "A commissioner said federal housing funds may mean the homes cannot be limited to people with disabilities.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "sY6AwUuHzjI",
