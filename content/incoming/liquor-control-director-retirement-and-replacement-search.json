    {
      "dateISO": "2026-09-21",
      "text": "Director hiring is a standing item on the regular agenda and can be discussed at the October meeting.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "0NdqPwWtF4o",
