  "asOfISO": "2026-10-23",
  "timeline": [
    {
      "dateISO": "2026-09-04",
      "text": "The budget director said the Council is going to suspend meetings to focus on the South Maui Community Plan.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "UsJUbzdqBgw",
        "ts": "0:47:15",
        "retrievedISO": "2026-10-16T16:08:54.867Z"
      },
      "body": "County Council Meeting"
    },
    {
      "dateISO": "2024-12-10",
      "text": "The commission will resume its review in January.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "nBW_aexDotM",
        "ts": "2:10:36",
        "retrievedISO": "2026-10-12T06:30:18.226Z"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2024-12-10",
      "text": "A commissioner proposed delaying a proposed industrial project outside the growth boundary.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "nBW_aexDotM",
        "ts": "2:08:01",
        "retrievedISO": "2026-10-12T06:30:18.226Z"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2024-12-10",
      "text": "Open space designations for undeveloped parcels in the sea level rise exposure area: The commission flagged the open space designations for undeveloped parcels in the sea level rise area to revisit later.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "nBW_aexDotM",
        "ts": "2:05:44",
        "retrievedISO": "2026-10-12T06:30:18.226Z"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2024-12-10",
      "text": "The director said the community plan is not the right tool to stop building on undeveloped land at risk from sea level rise.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "nBW_aexDotM",
        "ts": "1:54:33",
        "retrievedISO": "2026-10-12T06:30:18.226Z"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2024-12-10",
      "text": "Staff said a sentence on expected population growth and housing units needed could be added to the plan.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "nBW_aexDotM",
        "ts": "1:49:03",
        "retrievedISO": "2026-10-12T06:30:18.226Z"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2024-12-10",
      "text": "Staff noted the sentence could go in the \"South Maui today\" part of Section 1.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "nBW_aexDotM",
        "ts": "1:48:43",
        "retrievedISO": "2026-10-12T06:30:18.226Z"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2024-12-10",
      "text": "The director said the department is happy to put the housing paper's numbers into the plan.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "nBW_aexDotM",
        "ts": "1:45:19",
        "retrievedISO": "2026-10-12T06:30:18.226Z"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2024-12-10",
      "text": "Staff said counting every approved housing unit would mean reviewing every permit ever issued.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "nBW_aexDotM",
        "ts": "1:42:22",
        "retrievedISO": "2026-10-12T06:30:18.226Z"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2024-12-10",
      "text": "A commissioner said the high-end forecast of 1,700 homes puts in perspective how much more housing will be needed.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "nBW_aexDotM",
        "ts": "1:40:39",
        "retrievedISO": "2026-10-12T06:30:18.226Z"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2024-12-10",
      "text": "A commissioner said a forecast paper shows 800 to 1,700 homes needed over the next 20 years.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "nBW_aexDotM",
        "ts": "1:37:11",
        "retrievedISO": "2026-10-12T06:30:18.226Z"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2024-12-10",
      "text": "Staff said the housing need number covers the whole plan region and cannot be split by sub area.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "nBW_aexDotM",
        "ts": "1:36:32",
        "retrievedISO": "2026-10-12T06:30:18.226Z"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2024-12-10",
      "text": "The Maui Planning Commission met to review the South Maui Community Plan.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "nBW_aexDotM",
        "ts": "0:00:40",
        "retrievedISO": "2026-10-12T06:30:18.226Z"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2024-11-26",
      "text": "The next agenda is planned to cover sub-area 3 and its connected areas of change.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "lZr-bds8cyM",
        "ts": "3:30:02",
        "retrievedISO": "2026-10-12T06:30:25.220Z"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2024-11-26",
      "text": "The director said staff will work with the commission's legal adviser on a clearer process for growth boundary change requests.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "lZr-bds8cyM",
        "ts": "3:29:17",
        "retrievedISO": "2026-10-12T06:30:25.220Z"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2024-11-26",
      "text": "A motion to change the requested parcel to industrial was withdrawn.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "lZr-bds8cyM",
        "ts": "3:27:59",
        "retrievedISO": "2026-10-12T06:30:25.220Z"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2024-11-26",
      "text": "Six commissioners voted for other policy changes for that area, with parks added.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "lZr-bds8cyM",
        "ts": "3:04:19",
        "retrievedISO": "2026-10-12T06:30:25.220Z"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2024-11-26",
      "text": "North Kīhei mauka stakeholder committee policy: Commissioners agreed to list lineal descendants first and remove the numbers from the stakeholder list.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "lZr-bds8cyM",
        "ts": "2:42:44",
        "retrievedISO": "2026-10-12T06:30:25.220Z"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2024-11-26",
      "text": "Staff were asked to flag the gulch policies, 2.4.5 A and B, for the commission to revisit.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "lZr-bds8cyM",
        "ts": "2:24:42",
        "retrievedISO": "2026-10-12T06:30:25.220Z"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2024-11-26",
      "text": "A commissioner said wider buffers absorb rainfall and runoff and reduce flooding and erosion.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "lZr-bds8cyM",
        "ts": "2:10:04",
        "retrievedISO": "2026-10-12T06:30:25.220Z"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2024-11-26",
      "text": "An attorney for a landowner proposed text calling for up to 80% residential and 20% commercial and industrial.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "lZr-bds8cyM",
        "ts": "0:49:09",
        "retrievedISO": "2026-10-12T06:30:25.220Z"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2024-11-26",
      "text": "A company representative asked the commission to change one parcel from agriculture to industrial.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "lZr-bds8cyM",
        "ts": "0:43:57",
        "retrievedISO": "2026-10-12T06:30:25.220Z"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2024-11-26",
      "text": "A testifier asked where water would come from and where sewage would go for new homes.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "lZr-bds8cyM",
        "ts": "0:22:43",
        "retrievedISO": "2026-10-12T06:30:25.220Z"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2024-11-26",
      "text": "A resident said her area is under water use limits right now.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "lZr-bds8cyM",
        "ts": "0:19:20",
        "retrievedISO": "2026-10-12T06:30:25.220Z"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2024-11-26",
      "text": "A resident said there are only two roads out of her area during emergencies.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "lZr-bds8cyM",
        "ts": "0:11:37",
        "retrievedISO": "2026-10-12T06:30:25.220Z"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2024-11-26",
      "text": "A resident asked the commission for a public hearing.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "lZr-bds8cyM",
        "ts": "0:10:14",
        "retrievedISO": "2026-10-12T06:30:25.220Z"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2024-11-26",
      "text": "The director said such a change would also need a recommendation to amend the Maui Island Plan.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "lZr-bds8cyM",
        "ts": "0:04:00",
        "retrievedISO": "2026-10-12T06:30:25.220Z"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2024-11-26",
      "text": "The planning director said the department does not recommend adding land outside the urban growth boundary, the line that marks where growth may happen.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "lZr-bds8cyM",
        "ts": "0:03:43",
        "retrievedISO": "2026-10-12T06:30:25.220Z"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2024-11-26",
      "text": "The Maui Planning Commission met to keep working on the South Maui Community Plan.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "lZr-bds8cyM",
        "ts": "0:00:42",
        "retrievedISO": "2026-10-12T06:30:25.220Z"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2024-11-12",
      "text": "The chair asked commissioners to read what each land use designation allows before the next meeting.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "xd6QmAS0NbE",
        "ts": "3:45:24",
        "retrievedISO": "2026-10-15T06:35:22.762Z"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2024-11-12",
      "text": "The commission will continue this discussion at its meeting two weeks from now.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "xd6QmAS0NbE",
        "ts": "3:45:03",
        "retrievedISO": "2026-10-15T06:35:22.762Z"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2024-11-12",
      "text": "A commissioner worried \"small town center\" could allow mostly commercial building.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "xd6QmAS0NbE",
        "ts": "3:44:01",
        "retrievedISO": "2026-10-15T06:35:22.762Z"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2024-11-12",
      "text": "The planning department said it can label the project areas on the area of change map.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "xd6QmAS0NbE",
        "ts": "2:46:03",
        "retrievedISO": "2026-10-15T06:35:22.762Z"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2024-11-12",
      "text": "The planning department said the plan cannot place industrial land outside the urban growth boundary.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "xd6QmAS0NbE",
        "ts": "2:34:39",
        "retrievedISO": "2026-10-15T06:35:22.762Z"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2024-11-12",
      "text": "Format of sub area descriptions: Commissioners agreed by consensus that sub area descriptions, including history, go in table form; no vote was taken.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "xd6QmAS0NbE",
        "ts": "2:31:38",
        "retrievedISO": "2026-10-15T06:35:22.762Z"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2024-11-12",
      "text": "A Maui Tomorrow speaker said the group will not stand in the way of residential use on the land.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "xd6QmAS0NbE",
        "ts": "1:20:16",
        "retrievedISO": "2026-10-15T06:35:22.762Z"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2024-11-12",
      "text": "A ranch representative objected to requiring the whole collector road before any house is built.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "xd6QmAS0NbE",
        "ts": "1:12:49",
        "retrievedISO": "2026-10-15T06:35:22.762Z"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2024-11-12",
      "text": "An attorney for the owner of 13 acres there said only \"small town center\" would allow housing on that land.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "xd6QmAS0NbE",
        "ts": "1:05:14",
        "retrievedISO": "2026-10-15T06:35:22.762Z"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2024-11-12",
      "text": "A resident testified that the area needs housing, which a residential designation ensures.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "xd6QmAS0NbE",
        "ts": "0:14:27",
        "retrievedISO": "2026-10-15T06:35:22.762Z"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2024-11-12",
      "text": "The focus was the growth framework for sub area 1 and sub area 2, North Kīhei.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "xd6QmAS0NbE",
        "ts": "0:02:25",
        "retrievedISO": "2026-10-15T06:35:22.762Z"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2024-11-12",
      "text": "The Maui Planning Commission met November 12, 2024, to continue reviewing the South Maui Community Plan.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "xd6QmAS0NbE",
        "ts": "0:00:34",
        "retrievedISO": "2026-10-15T06:35:22.762Z"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2024-10-22",
      "text": "The next meeting will have largely the same agenda because the commission did not take action.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "1Vfea2KJerM",
        "ts": "1:47:18",
        "retrievedISO": "2026-10-15T06:35:37.723Z"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2024-10-22",
      "text": "A Maui Tomorrow speaker said even Small Town Center would require changing the land use commission order to allow housing.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "1Vfea2KJerM",
        "ts": "1:40:58",
        "retrievedISO": "2026-10-15T06:35:37.723Z"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2024-10-22",
      "text": "A nearby resident said he supported Small Town Center with mostly housing and small shops.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "1Vfea2KJerM",
        "ts": "1:30:54",
        "retrievedISO": "2026-10-15T06:35:37.723Z"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2024-10-22",
      "text": "A ranch representative asked to designate about 80 acres above the wastewater treatment plant for industrial use.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "1Vfea2KJerM",
        "ts": "1:17:54",
        "retrievedISO": "2026-10-15T06:35:37.723Z"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2024-10-22",
      "text": "A landowner's representative said that if the area stays residential, nothing will be built there, including homes.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "1Vfea2KJerM",
        "ts": "0:59:02",
        "retrievedISO": "2026-10-15T06:35:37.723Z"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2024-10-22",
      "text": "A landowner's representative said a proposed 150-foot setback would cut into land set aside for workforce housing at the 670 property.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "1Vfea2KJerM",
        "ts": "0:57:39",
        "retrievedISO": "2026-10-15T06:35:37.723Z"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2024-10-22",
      "text": "He said the project would then be mostly housing.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "1Vfea2KJerM",
        "ts": "0:39:23",
        "retrievedISO": "2026-10-15T06:35:37.723Z"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2024-10-22",
      "text": "Another testifier supported keeping the gulches on the maps.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "1Vfea2KJerM",
        "ts": "0:24:30",
        "retrievedISO": "2026-10-15T06:35:37.723Z"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2024-10-22",
      "text": "A speaker for four short-term rental properties with 782 owners asked to change them from residential to resort hotel.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "1Vfea2KJerM",
        "ts": "0:16:15",
        "retrievedISO": "2026-10-15T06:35:37.723Z"
      },
      "body": "Maui Planning Commission"
    },
    {
      "dateISO": "2024-10-22",
      "text": "A resort employee asked to remove two gulch and drainage areas from the plan maps.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "1Vfea2KJerM",
        "ts": "0:05:36",
        "retrievedISO": "2026-10-15T06:35:37.723Z"
      },
      "body": "Maui Planning Commission"
