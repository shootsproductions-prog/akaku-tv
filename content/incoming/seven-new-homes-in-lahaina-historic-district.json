      "text": "Test trenches on the planned home sites found no burials.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "F1fUs_ROA_Q",
        "ts": "1:25:54",
        "retrievedISO": "2026-10-13T06:35:22.251Z"
      },
      "body": "Maui Cultural Resources Commission"
    },
    {
