      "text": "Members agreed to use the existing interview questions and grading.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "3Jc9Mp68Wcs",
        "ts": "0:16:12",
        "endTs": "0:16:42",
        "retrievedISO": "2026-10-07T23:03:48.406Z"
      }
    },
    {
      "dateISO": "2026-09-23",
      "text": "Applications for the 2027 mass nominations are due November 11th.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "3Jc9Mp68Wcs",
        "ts": "0:13:58",
        "endTs": "0:15:26",
        "retrievedISO": "2026-10-07T23:03:48.406Z"
      }
    },
    {
