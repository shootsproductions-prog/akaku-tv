      "text": "Members at the pineapple festival passed out flyers but received no applications.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "DN-bXIWkS7E",
        "ts": "0:02:34",
        "endTs": "0:03:13",
        "retrievedISO": "2026-10-13T06:35:15.675Z"
      },
      "body": "Independent Nomination Board"
    },
