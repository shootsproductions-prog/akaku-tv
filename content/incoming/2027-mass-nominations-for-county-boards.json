      "text": "Two members will recruit at the senior fair on November 21st at the Cameron Center.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "3Jc9Mp68Wcs",
        "ts": "0:09:38",
        "endTs": "0:10:08",
        "retrievedISO": "2026-10-07T23:03:48.406Z"
      }
    },
    {
