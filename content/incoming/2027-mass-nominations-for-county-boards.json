      "source": {
        "type": "meeting",
        "videoId": "3Jc9Mp68Wcs",
        "ts": "0:18:09",
        "endTs": "0:18:43",
        "retrievedISO": "2026-10-07T23:03:48.406Z"
      }
    },
    {
