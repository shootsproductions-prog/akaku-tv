  "timeline": [
    {
      "dateISO": "2026-08-20",
      "text": "Defer the item on transitioning the county to Maui County: No one objected, so the item was deferred.",
      "basis": "said-at-meeting",
      "source": {
        "type": "meeting",
        "videoId": "pXD4AJPMtzM",
