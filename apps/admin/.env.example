# Akakū TV pipeline — environment template
#
# Copy to .env.local and fill in real values. .env.local is gitignored.
# Real values live in 1Password under "Akakū — Mux Archive token".
# (Session containers are ephemeral, so .env.local will not persist
#  between Claude Code sessions — re-paste from 1Password each time.)

# Mux API access token — Production environment.
# Mint at: Mux dashboard → Settings → Access Tokens → Generate new token.
# Scopes: Mux Video (R+W), Mux Data (R). Nothing else.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# Mux Data env key — client-side, safe to embed (NOT an API secret).
# Used by the Stage 2 native SceneGraph channel for playback analytics.
NEXT_PUBLIC_MUX_DATA_ENV_KEY=0gjatkrb5antr7d70tl0bn1oo

# Mux webhook signing secret — added in Step 6 of docs/mux-account-setup.md
# once the catalog tool is live and a webhook endpoint exists. Leave blank
# for now.
MUX_WEBHOOK_SIGNING_SECRET=
